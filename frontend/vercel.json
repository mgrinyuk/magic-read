{
  "rewrites": [
    {
      "source": "/english",
      "destination": "/english.html"
    },
    {
      "source": "/checklist",
      "destination": "/checklist.html"
    },
    {
      "source": "/apps",
      "destination": "/apps.html"
    }
  ],
  "redirects": [
    {
      "source": "/deck/:token",
      "destination": "/?deck=:token",
      "permanent": false
    },
    {
      "source": "/assignment/:token",
      "destination": "/?assignment=:token",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
